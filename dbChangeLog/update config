INSERT INTO config (
    company_id, code, value, description, create_time, update_time, updater, creator, test, platform
)
SELECT
    id AS company_id,
    'time_update_bill' AS code,
    null AS value,
    N'Thời gian cho phép khách chủ cập nhật thông tin đơn hàng trước khi xuất hóa đơn (hh:mm:ss)' AS description,
    GETDATE() AS create_time,
    GETDATE() AS update_time,
    0 AS updater,
    0 AS creator,
    null AS test,
    null AS platform
FROM company
WHERE id NOT IN (
    SELECT DISTINCT c.company_id
    FROM config c
    WHERE c.code = 'time_update_bill'
);

